generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          Int      @id
  name        String
  imageKey    String    @map("image_key")
  iconKey     String    @map("icon_key")
  description String
  color       String
  link        String
  sortOrder   Int       @unique @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("projects")
}

model Experience {
  id          Int      @id
  company     String
  role        String
  iconKey     String    @map("icon_key")
  period      String
  status      String
  description String[]
  sortOrder   Int       @unique @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("experiences")
}

model Skill {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  icon        String
  link        String
  description String?
  color       String?
  category    String
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([category, sortOrder])
  @@map("skills")
}

model Link {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  icon      String
  url       String
  category  String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, sortOrder])
  @@map("links")
}

model SiteSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
